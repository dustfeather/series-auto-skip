{
  "name": "series-auto-skip",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node scripts/stamp-version.mjs && node build.mjs && node scripts/pack.mjs chrome",
    "build:firefox": "node scripts/stamp-version.mjs && node build.mjs && node scripts/pack.mjs firefox",
    "build:docs": "sass docs/scss/main.scss docs/css/main.css --style=compressed --no-source-map",
    "watch": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife --target=es2020 --watch",
    "watch:docs": "sass docs/scss/main.scss docs/css/main.css --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.103.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.0": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "immutable": ">=5.1.8",
      "nanoid": ">=3.3.18"
    }
  }
}
